# Copy to .env.local. Never commit real secrets.
AI_PROVIDER=mock
# Only needed when AI_PROVIDER=anthropic (placeholders; models are chosen at implementation time)
ANTHROPIC_API_KEY=
AI_MODEL_ANALYSIS=
AI_MODEL_CHAT=
DATABASE_PATH=./data/instructor.db
STORAGE_ROOT=./data/files
# Required in production: a random value of at least 32 bytes (e.g. `openssl rand -base64 48`).
# The server refuses to start in production if it is empty, `change-me` or too short.
SESSION_SECRET=
MOCK_AI_DELAY_MS=0
# Optional: absolute path of src/lib/render/pdf-child.mjs (default: found from the package root)
RENDER_CHILD_PATH=
# Number of trusted reverse proxies in front of the app; 0 ignores X-Forwarded-For entirely
TRUST_PROXY_HOPS=0
# Optional per-session guide quota per 30 days (empty = unlimited)
FREE_GUIDES_PER_MONTH=
