    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
