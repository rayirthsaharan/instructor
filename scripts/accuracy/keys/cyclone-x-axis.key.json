  "warnings": [
    {
      "text": "Si las varillas no entran bien, usa un martillo de goma para ayudarte.",
      "pageIndex": 1,
      "step": 1
    },
    {
      "text": "Encaja los rodamientos en la pieza impresa asegurándote de que al hacerlo suena un “click” y quedan bien centrados.",
      "pageIndex": 2,
      "step": 2
    },
    {
      "text": "No aprietes del todo los tornillos.",
      "pageIndex": 3,
      "step": 3
    },
    {
      "text": "Aprieta las tuercas ayudándote de la llave fija mientras sujetas el engranaje.",
      "pageIndex": 4,
      "step": 4
    },
    {
      "text": "El lado en el que está embutida la tuerca debe quedar hacia la parte larga de la varilla.",
      "pageIndex": 4,
      "step": 4
    },
    {
      "text": "Aplica lubricante a las varillas roscadas.",
      "pageIndex": 8,
      "step": 7
    },
    {
      "text": "Aprieta todos los tornillos que sujetan los rodamientos del carro.",
      "pageIndex": 9,
      "step": 8
    },
    {
      "text": "Fíjate en la posición de la tuerca autoblocante.",
      "pageIndex": 9,
      "step": 8
    },
    {
      "text": "Aprieta el tornillo contra la parte plana del eje del motor.",
      "pageIndex": 10,
      "step": 9
    },
    {
      "text": "No aprietes el espárrago del todo.",
      "pageIndex": 10,
      "step": 9
    },
    {
      "text": "Ajusta el motor para que los engranajes engranen y aprieta el tornillo.",
      "pageIndex": 11,
      "step": 10
    },
    {
      "text": "Asegúrate de que el conector del motor queda orientado hacia la parte exterior.",
      "pageIndex": 11,
      "step": 10
    }
  ]
}
